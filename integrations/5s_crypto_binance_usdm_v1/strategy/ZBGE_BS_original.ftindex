ZBGE1:=(C-LLV(L,55))/(HHV(H,55)-LLV(L,55))*100;
ZBGE2:=EMA(SMA(3*ZBGE1,5,1)-2*SMA(SMA(ZBGE1,5,1),3,1),3);
ZBGE3:=SMA(ABS(L-REF(L,1)),3,1)/SMA(MAX(L-REF(L,1),0),3,1)*100;
ZBGE4:=EMA(ZBGE3*10,3);
ZBGE5:=LLV(L,38);
ZBGE6:=HHV(ZBGE4,38);
ZBGE7:=EMA(IF(L<=ZBGE5,(ZBGE4+ZBGE6*2)/2,0),3)/618;
ZBGE8:=IF(ZBGE7>=100,100,ZBGE7);
ZBGE9:=SMA(ABS(L-REF(L,1)),3,1)/SMA(MAX(L-REF(L,1),0),3,1)*100;
ZBGE10:=EMA(ZBGE9*10,3);
ZBGE11:=LLV(L,13);
ZBGE12:=HHV(ZBGE10,13);
ZBGE13:=EMA(IF(LOW<=ZBGE11,(ZBGE10+ZBGE12*2)/2,0),3)/618;
ZBGE14:=IF(ZBGE13>500,500,ZBGE13);
ZBGE15:=(CLOSE-LLV(LOW,9))/(HHV(HIGH,9)-LLV(LOW,9))*100;
ZBGE16:=SMA(ZBGE15,3,1);
ZBGE17:=SMA(ZBGE16,3,1);
ZBGE18:=3*ZBGE16-2*ZBGE17;
NOTEXT1:0,POINTDOT,LINETHICK1;
NOTEXT21:100,POINTDOT,LINETHICK1;
NOTEXT22:85,POINTDOT,LINETHICK1;
趋势吸筹:IF(ZBGE2<=14,ZBGE2,DRAWNULL),NODRAW,COLORCYAN;
笑脸条件:=ZBGE2>85 AND ZBGE2>REF(ZBGE2,1);
DRAWICON(笑脸条件,100,35);
DRAWICON(笑脸条件,90,35);
DRAWICON(笑脸条件,80,35);
主力吸筹:IF(ZBGE8>0,ZBGE8,DRAWNULL),COLORRED,NODRAW;
最强吸筹:IF(ZBGE14>-120,ABS(ZBGE14),DRAWNULL),COLORGRAY,NODRAW;
ZBGE19:=MAX(趋势吸筹,MAX(主力吸筹,最强吸筹));
ZBGE20:=MIN(趋势吸筹,MIN(主力吸筹,最强吸筹));
ZBGE21:=RANGE(趋势吸筹,ZBGE20,ZBGE19)=1;
ZBGE22:=RANGE(主力吸筹,ZBGE20,ZBGE19)=1;
ZBGE23:=RANGE(最强吸筹,ZBGE20,ZBGE19)=1;
ZBGE24:=IF(ZBGE14>-120,ZBGE14,0);
ZBGE25:=ZBGE24<REF(ZBGE24,1);
ZBGE26:=SMA(((HHV(C,13)-C)/(HHV(C,13)-LLV(C,13))),5,1);
ZBGE27:=(C-LLV(L,9))/(HHV(H,9)-LLV(L,9))*100;
ZBGE28:=SMA(ZBGE27,3,1);
ZBGE29:=SMA(ZBGE28,3,1);
ZBGE30:=CROSS(ZBGE28,ZBGE29) AND ZBGE28<20;
ZBGE31:=BARSLAST(CROSS(ZBGE29,ZBGE28))<9 AND ZBGE30;
ZBGE32:=CROSS(ZBGE27,ZBGE28) AND ZBGE28<30;
ZBGE33:=IF(BARSLAST(CROSS(ZBGE28,ZBGE27))>=3 AND ZBGE32,20,0);
ZBGE34:=ZBGE14>1 AND ZBGE18>REF(ZBGE18,1);
ZBGE35:=ZBGE14>0.1 AND ZBGE14<1 AND ZBGE18>REF(ZBGE18,2);
顶级主力:=CROSS(ZBGE28,ZBGE27) AND ZBGE27>50;
跟随主力:=IF(BARSLAST(CROSS(ZBGE27,ZBGE28))>=4 AND 顶级主力,20,0);
黄柱:ZBGE34 AND REF(ZBGE18,1)<REF(ZBGE18,2),COLORYELLOW,NODRAW;
粉柱:ZBGE35 AND REF(ZBGE18,1)<REF(ZBGE18,2),COLORMAGENTA,NODRAW;
STICKLINE(趋势吸筹=ZBGE19,0,IF(趋势吸筹>0,趋势吸筹,DRAWNULL),2,0),COLORCYAN;
STICKLINE(主力吸筹=ZBGE19,0,IF(主力吸筹>0,主力吸筹,DRAWNULL),2,0),COLORRED;
STICKLINE(最强吸筹=ZBGE19,0,IF(最强吸筹>0,最强吸筹,DRAWNULL),2,1),COLORGRAY;
STICKLINE(ZBGE21,0,IF(趋势吸筹>0,趋势吸筹,DRAWNULL),2,0),COLORCYAN;
STICKLINE(ZBGE22,0,IF(主力吸筹>0,主力吸筹,DRAWNULL),2,0),COLORRED;
STICKLINE(ZBGE23,0,IF(最强吸筹>0,最强吸筹,DRAWNULL),2,1),COLORGRAY;
STICKLINE(趋势吸筹=ZBGE20,0,IF(趋势吸筹>0,趋势吸筹,DRAWNULL),2,0),COLORCYAN;
STICKLINE(主力吸筹=ZBGE20,0,IF(主力吸筹>0,主力吸筹,DRAWNULL),2,0),COLORRED;
STICKLINE(最强吸筹=ZBGE20,0,IF(最强吸筹>0,最强吸筹,DRAWNULL),2,1),COLORGRAY;
STICKLINE(黄柱,0,ZBGE14,0.1,0),COLORYELLOW;
STICKLINE(粉柱,0,ZBGE14,0.1,0),COLORMAGENTA;
冲顶:2/ZBGE26-2,NODRAW,COLORGREEN;
STICKLINE(2/ZBGE26-2>0,20,2/ZBGE26-2+20,0,-1),COLORLIRED;
STICKLINE(1/13>ZBGE26,0+20,2/ZBGE26-2+20,1,0),COLORRED;
STICKLINE(1/13>ZBGE26,0+20,2/ZBGE26-2+20,0,0),COLORRED;
趋势线:ZBGE2-10,COLORBLUE,LINETHICK2;
趋势大牛:IF(BARSLAST(CROSS(ZBGE28,ZBGE29))<9 AND ZBGE31,100,0),COLORWHITE,LINETHICK2,STICK;
{跟随主力：80~100之间的绿色小柱}
STICKLINE(跟随主力,80,100,3,0),COLORGREEN;

{==== 买入B：黄柱+趋势线<20+主力吸筹>15 ====}
BUY条件:=黄柱 AND 趋势线<20 AND ZBGE8>15;
DRAWTEXT(BUY条件,ZBGE14*0.8,'B'),COLORYELLOW;

{==== S卖出两个条件，满足任意一个即触发 ====}
{条件A：跟随主力绿色小柱 + 趋势线>75}
SELL_A:=跟随主力>0 AND 趋势线>75;

{条件B：连续笑脸，仅第3根K线标记一次S，后续持续笑脸不重复S，中断后重新计数}
连续笑脸根数:=BARSLASTCOUNT(笑脸条件);
SELL_B:=连续笑脸根数=3;

SELL条件:=SELL_A OR SELL_B;
DRAWTEXT(SELL条件,103,'S'),COLORRED;
